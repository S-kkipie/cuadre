<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notification access is granted by the user in system Settings, not via a runtime permission.
         BIND_NOTIFICATION_LISTENER_SERVICE is held by the service below. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Package visibility (Android 11+): needed to see which wallet apps are installed and
         check their battery restriction. Keep in sync with Wallet.packages. -->
    <queries>
        <package android:name="com.bcp.innovacxion.yapeapp" />
        <package android:name="com.bbva.nxt_peru" />
        <package android:name="pe.com.interbank.mobilebanking" />
        <package android:name="pe.com.interbank.mpay.customer" />
        <package android:name="pe.com.scotiabank.blpm.android.client" />
        <package android:name="pe.com.banbif.pnappmobile" />
        <package android:name="com.cmac.cajamovilaqp" />
        <package android:name="com.cajaarq.p51" />
        <package android:name="com.cmacica.prd" />
        <package android:name="com.cajahuancayo.cajahuancayo.appcajahuancayo" />
        <package android:name="pe.confianza.cliente" />
        <package android:name="com.alfinbanco.appclientes" />
        <package android:name="pe.com.tarjetasperuanasprepago.tppapp" />
        <package android:name="com.mibanco.bancamovil" />
        <package android:name="pe.pichincha.bm" />
    </queries>

    <application
        android:name=".CuadreApp"
        android:label="Cuadre"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".notifications.PaymentNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>
</manifest>
